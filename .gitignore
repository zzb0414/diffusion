.ipynb_checkpoints
*.pyc

# Experiment outputs that stay local:
#  - model weights (large; sha256 recorded in checkpoints/*/MANIFEST.md)
#  - CSV / PNG written by Python, which this workstation's endpoint encryption
#    stores encrypted at rest (unreadable outside Python)
*.pkl
runs/**/*.csv
runs/**/*.png
checkpoints/**/*.csv
checkpoints/**/*.png

# legacy demo weights (kept on disk only)
legacy/saved_models/

# figure scripts kept local, not versioned (user decision 2026-10-28)
experiments/_diagram*.py
experiments/_docx_read.py

# scratch
_dev/
runs/_*/

# decoded display arrays (derived from the data; regenerate with experiments/_cv_ratio_eval.py)
runs/**/*.npy

runs/**/*.done
