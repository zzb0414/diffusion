__pycache__
.ipynb_checkpoints
*.pyc

# Experiment outputs that stay local:
#  - model weights (large; sha256 recorded in checkpoints/*/MANIFEST.md)
#  - CSV / PNG written by Python, which this workstation's endpoint encryption
#    stores encrypted at rest (unreadable outside Python)
*.pkl
runs/**/*.csv
runs/**/*.png
checkpoints/**/*.csv
checkpoints/**/*.png

# ...except the R3 / R4 figures, committed as-is (still encrypted: they open
# only on machines with the company encryption client)
!runs/r3_total/**/*.png
!runs/r4_subset/**/*.png
!runs/r4b_subset/**/*.png

# scratch
_dev/
runs/_*/
